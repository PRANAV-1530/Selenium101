<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LambdaTestSuite" parallel="tests" thread-count="2">
    <test name="Win10ChromeTest">
        <parameter name="browser" value="Chrome"/>
        <parameter name="version" value="latest"/>
        <parameter name="platform" value="Windows 10"/>
        <classes>
            <class name="com.lambdatest.SimpleFormDemoclass"/>
            <class name="com.lambdatest.DragAndDropSlidersClass"/>
            <class name="com.lambdatest.InputFormSubmitClass"/>
        </classes>
    </test>
    <test name="MacSafariTest">
        <parameter name="browser" value="Safari"/>
        <parameter name="version" value="latest"/>
        <parameter name="platform" value="macOS Catalina"/>
        <classes>
            <class name="com.lambdatest.SimpleFormDemoclass"/>
            <class name="com.lambdatest.DragAndDropSlidersClass"/>
            <class name="com.lambdatest.InputFormSubmitClass"/>
        </classes>
    </test>
</suite>
